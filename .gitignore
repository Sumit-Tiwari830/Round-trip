# ==========================================
# RoundTrip Project Root .gitignore
# ==========================================

# Environment variables & secrets
.env
.env.local
.env.*.local
*.env
!.env.example

# Node / Frontend artifacts
node_modules/
dist/
dist-ssr/
build/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Java / Maven artifacts
target/
*.class
*.jar
*.war
*.ear
*.original
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# IDE, Editor & OS metadata
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.sublime-workspace
*.sublime-project
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
*.swp
*.swo
*~

# Logs & Temporary files
*.log
logs/
tmp/
temp/
test_post.py
*.pid
*.seed

# Database / Docker persistent volumes
mongodata/
mongo_data/
.mongo/
